# Free Form Delivery Service (Choose either Web3Forms or Formspree):
# Option A: Web3Forms (https://web3forms.com - instant free access key sent to your email, no account needed)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Option B: Formspree (https://formspree.io - register free and paste your form ID)
NEXT_PUBLIC_FORMSPREE_ID=

# Used for metadata / OG tags once deployed
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
